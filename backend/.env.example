PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/koyamon-mart
CLIENT_URL=http://localhost:5173
JWT_SECRET=your_secret

# Store location (Padikkal, Velimukku, Malappuram) — used for delivery distance/fee calculation
STORE_LAT=11.0825
STORE_LNG=75.9083
MAX_DELIVERY_KM=10
DELIVERY_BASE_FEE=15
DELIVERY_RATE_PER_KM=8
FREE_DELIVERY_ABOVE=500

# Razorpay
RAZORPAY_KEY_ID=rzp_live_xxxxx
RAZORPAY_KEY_SECRET=xxxxx

# SMS / OTP delivery — 'console' logs OTPs to the server console (dev only)
SMS_PROVIDER=console
MSG91_AUTH_KEY=xxxxx
MSG91_TEMPLATE_ID=xxxxx
TWILIO_SID=xxxxx
TWILIO_TOKEN=xxxxx
TWILIO_FROM=xxxxx

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=xxxxx
CLOUDINARY_API_KEY=xxxxx
CLOUDINARY_API_SECRET=xxxxx

# Used by scripts/createAdmin.js to seed the first admin account
ADMIN_EMAIL=admin@koyamonmart.com
ADMIN_PASSWORD=change_me
